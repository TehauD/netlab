# netlab configuration — every value shown is the default.
# Copy to .env for reference. Nothing here is required to run.

# --- Network binding ---------------------------------------------------------
# Loopback only. Changing this exposes an endpoint that ingests personal contact
# data to your network; the server logs a warning at startup if you do.
NETLAB_HOST=127.0.0.1
NETLAB_PORT=8787

# --- Logging -----------------------------------------------------------------
# Logs contain counts, durations, and error classes — never connection contents.
NETLAB_LOG_LEVEL=INFO
NETLAB_LOG_JSON=false

# --- Privacy -----------------------------------------------------------------
# Force redaction (names → initials, URLs stripped) on every response.
NETLAB_REDACT=false
# Reserved. No code path currently writes analysis data to disk.
NETLAB_ALLOW_PERSISTENCE=false

# --- Resource guards ---------------------------------------------------------
# A 30k-connection export is roughly 4 MB.
NETLAB_MAX_UPLOAD_MB=64
# Render cap only — the analysis still covers every row.
NETLAB_MAX_GRAPH_NODES=6000

# --- CORS --------------------------------------------------------------------
# Empty means same-origin only, which is correct for the bundled UI.
NETLAB_CORS_ORIGINS=
